{
  "name": "excel-dap-an-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Excel 365 - trích xuất đáp án (PWA)",
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./tailwind.css --minify",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/jszip/dist/jszip.min.js','vendor/jszip.min.js')\"",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "tailwindcss": "^3.4.17"
  }
}
